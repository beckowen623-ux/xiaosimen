  "points": [
    {
      "id": "p23",
      "name": "提公因式法",
      "tag": "",
      "kp": [
        "因式分解"
      ],
      "card": {
        "concept": [
          "把一个多项式化成几个整式的积的形式，叫做因式分解（与整式乘法互逆）。",
          "找公因式三步：定系数（最大公约数）、定字母（各项相同字母）、定指数（最低次幂）。"
        ],
        "formula": [
          "ma＋mb＋mc＝m(a＋b＋c)。",
          "互为相反数的公因式转化：b－a＝－(a－b)；(b－a)²＝(a－b)²。"
        ],
        "pitfall": [
          "某一项恰好是公因式时，提出后括号里要留“1”，不能漏项。",
          "第一项带负号时，常连同负号一起提出来，括号内各项全变号。"
        ],
        "example": {
          "q": "分解因式：6a²b－3ab。",
          "a": "公因式是 3ab，结果＝3ab(2a－1)。"
        }
      },
      "qs": [
        {
          "lv": 1,
          "t": "c",
          "q": "下列从左到右的变形中，属于因式分解的是（ ）",
          "o": [
            "(x＋1)(x－1)＝x²－1",
            "x²－4x＋4＝(x－2)²",
            "x²－2x＋1＝x(x－2)＋1",
            "a(b＋c)＝ab＋ac"
          ],
          "a": "B",
          "e": "因式分解最终结果必须是整式的积的形式，只有 x²－4x＋4＝(x－2)² 符合。"
        },
        {
          "lv": 1,
          "t": "c",
          "q": "多项式 6a²b－9ab² 的公因式是（ ）",
          "o": [
            "3ab",
            "3a²b²",
            "6ab",
            "ab"
          ],
          "a": "A",
          "e": "系数最大公约数 3，相同字母最低次幂 a、b，公因式 3ab。"
        },
        {
          "lv": 1,
          "t": "c",
          "q": "把 3x²－6x 分解因式的结果是（ ）",
          "o": [
            "3x(x－2)",
            "3x(x－6)",
            "x(3x－6)",
            "3(x²－2x)"
          ],
          "a": "A",
          "e": "提取公因式 3x 得 3x(x－2)。坑点：没提尽。"
        },
        {
          "lv": 2,
          "t": "c",
          "q": "把 4a²b－2ab 分解因式的结果是（ ）",
          "o": [
            "2ab(2a)",
            "2ab(2a－1)",
            "2ab(2a－2)",
            "ab(4a－2)"
          ],
          "a": "B",
          "e": "提出 2ab 后第二项剩 －1，得 2ab(2a－1)。坑点：漏掉 －1。"
        },
        {
          "lv": 2,
          "t": "c",
          "q": "把 a(x－y)＋b(y－x) 分解因式的结果是（ ）",
          "o": [
            "(x－y)(a＋b)",
            "(x－y)(a－b)",
            "(y－x)(a－b)",
            "(x＋y)(a－b)"
          ],
          "a": "B",
          "e": "把 y－x 写成 －(x－y)，提取 (x－y) 得 (x－y)(a－b)。"
        },
        {
          "lv": 2,
          "t": "b",
          "q": "已知 a＋b＝4，ab＝3，则 a²b＋ab²＝______。",
          "a": "12",
          "e": "a²b＋ab²＝ab(a＋b)＝3×4＝12。"
        },
        {
          "lv": 3,
          "t": "b",
          "q": "利用提公因式法计算：2026×17＋2026×83＝______。",
          "a": "202600 / 202 600",
          "e": "2026×(17＋83)＝2026×100＝202 600。"
        },
        {
          "lv": 3,
          "t": "c",
          "q": "计算 2¹⁰－2⁹ 的结果是（ ）",
          "o": [
            "2",
            "2⁹",
            "2¹⁰",
            "1"
          ],
          "a": "B",
          "e": "提取公因式 2⁹：2⁹×(2－1)＝2⁹。"
