          "q": "已知 x²＋2x＝3，则 (x＋1)²＋x(x＋2)－2＝______。",
          "a": "5",
          "e": "展开得 x²＋2x＋1＋x²＋2x－2＝2(x²＋2x)－1＝2×3－1＝5。"
        },
        {
          "lv": 3,
          "t": "c",
          "q": "若 (x²＋px＋2)(x－3) 的结果中不含 x² 项，则 p 的值是（ ）",
          "o": [
            "－3",
            "0",
            "3",
            "6"
          ],
          "a": "C",
          "e": "x² 项系数为 p－3＝0，故 p＝3。"
        }
      ]
