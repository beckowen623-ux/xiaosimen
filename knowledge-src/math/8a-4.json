  "points": [
    {
      "id": "p17",
      "name": "幂的运算",
      "tag": "◆★",
      "kp": [
        "幂的运算",
        "积的乘方"
      ],
      "card": {
        "concept": [
          "同底数幂相乘：底数不变，指数相加。",
          "幂的乘方：底数不变，指数相乘。",
          "积的乘方：把积的每一个因式分别乘方，再把所得的幂相乘。"
        ],
        "formula": [
          "aᵐ·aⁿ＝aᵐ⁺ⁿ；(aᵐ)ⁿ＝aᵐⁿ；(ab)ⁿ＝aⁿbⁿ。",
          "逆用：aᵐ⁺ⁿ＝aᵐ·aⁿ；aᵐⁿ＝(aᵐ)ⁿ；aⁿbⁿ＝(ab)ⁿ。"
        ],
        "pitfall": [
          "系数也要乘方：(－2a²)³＝－8a⁶，常漏算 (－2)³ 或把指数相加写成 a⁵。",
          "合并同类项 a²＋a²＝2a²，别和同底数幂乘法 a²·a²＝a⁴ 混在一起！"
        ],
        "example": {
          "q": "计算 (－2a²b)³；已知 aᵐ＝2，aⁿ＝3，求 aᵐ⁺²ⁿ。",
          "a": "(－2a²b)³＝－8a⁶b³；aᵐ⁺²ⁿ＝aᵐ·(aⁿ)²＝2×3²＝18。"
        }
      },
      "qs": [
        {
          "lv": 1,
          "t": "c",
          "q": "计算 a²·a³ 的结果是（ ）",
          "o": [
            "a⁵",
            "a⁶",
            "2a⁵",
            "2a⁶"
          ],
          "a": "A",
          "e": "同底数幂相乘，底数不变指数相加：2＋3＝5，得 a⁵。"
        },
        {
          "lv": 1,
          "t": "c",
          "q": "计算 (a³)² 的结果是（ ）",
          "o": [
            "a⁵",
            "a⁶",
            "a⁹",
            "2a³"
          ],
          "a": "B",
          "e": "幂的乘方指数相乘：3×2＝6，得 a⁶。"
        },
        {
          "lv": 1,
          "t": "c",
          "q": "计算 (－2x²)³ 的结果是（ ）",
          "o": [
            "－6x⁶",
            "－8x⁶",
            "－8x⁵",
            "8x⁶"
          ],
          "a": "B",
          "e": "(－2)³·(x²)³＝－8x⁶。坑点：系数忘乘方或指数错相加。"
        },
        {
          "lv": 2,
          "t": "b",
          "q": "已知 aᵐ＝2，aⁿ＝5，则 aᵐ⁺ⁿ＝______。",
          "a": "10",
          "e": "逆用公式：aᵐ⁺ⁿ＝aᵐ·aⁿ＝2×5＝10。"
        },
        {
          "lv": 2,
          "t": "b",
          "q": "计算：0.25²⁰²⁶×4²⁰²⁶＝______。",
          "a": "1",
          "e": "逆用积的乘方：(0.25×4)²⁰²⁶＝1²⁰²⁶＝1。"
        },
        {
          "lv": 2,
          "t": "c",
          "q": "下列运算正确的是（ ）",
          "o": [
            "a²＋a³＝a⁵",
            "a²·a³＝a⁶",
            "(a²)³＝a⁵",
            "(2a)²＝4a²"
          ],
          "a": "D",
          "e": "a² 与 a³ 不是同类项；a²·a³＝a⁵；(a²)³＝a⁶；只有 (2a)²＝4a² 正确。"
        },
        {
          "lv": 3,
          "t": "b",
          "q": "已知 aᵐ＝3，aⁿ＝2，则 a²ᵐ⁺ⁿ＝______。",
          "a": "18",
          "e": "a²ᵐ⁺ⁿ＝(aᵐ)²·aⁿ＝3²×2＝18。"
        },
        {
          "lv": 3,
          "t": "c",
          "q": "计算 (－0.5)²⁰²⁵×2²⁰²⁶ 的结果是（ ）",
          "o": [
