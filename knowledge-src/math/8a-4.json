    {
      "id": "p19",
      "name": "平方差公式",
      "tag": "★",
      "kp": [
        "乘法公式"
      ],
      "card": {
        "concept": [
          "两数和与这两数差的积，等于它们的平方差。",
          "结构特征：一组完全相同的项（a），一组互为相反数的项（b 与 －b）。"
        ],
        "formula": [
          "(a＋b)(a－b)＝a²－b²（结果＝相同项²－相反项²）。"
        ],
        "pitfall": [
          "(－a＋b)(－a－b) 中相同项是 －a，相反项是 b，结果为 (－a)²－b²＝a²－b²，别写反！",
          "系数别忘平方：(2x＋3)(2x－3)＝4x²－9，不是 2x²－9。"
        ],
        "example": {
          "q": "用平方差公式简便计算 101×99。",
          "a": "(100＋1)(100－1)＝100²－1²＝10 000－1＝9 999。"
        }
      },
      "qs": [
        {
          "lv": 1,
          "t": "c",
          "q": "计算 (x＋3)(x－3) 的结果是（ ）",
          "o": [
            "x²－9",
            "x²＋9",
            "x²－6",
            "x²－6x＋9"
          ],
          "a": "A",
          "e": "直接套用平方差公式得 x²－9。"
        },
        {
          "lv": 1,
          "t": "c",
          "q": "计算 (2a＋1)(2a－1) 的结果是（ ）",
