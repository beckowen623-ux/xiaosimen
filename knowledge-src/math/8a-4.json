          "t": "c",
          "q": "计算 (－2x＋y)(－2x－y) 的结果是（ ）",
          "o": [
            "4x²－y²",
            "y²－4x²",
            "－4x²－y²",
            "4x²＋y²"
          ],
          "a": "A",
          "e": "相同项是 －2x，相反项是 y，结果＝(－2x)²－y²＝4x²－y²。"
        },
        {
          "lv": 2,
          "t": "b",
          "q": "计算：2026²－2025×2027＝______。",
          "a": "1",
          "e": "2025×2027＝(2026－1)(2026＋1)＝2026²－1，原式＝2026²－(2026²－1)＝1。"
