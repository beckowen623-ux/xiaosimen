    {
      "id": "p18",
      "name": "整式的乘法",
      "tag": "",
      "kp": [
        "整式运算"
      ],
      "card": {
        "concept": [
          "单×单：系数相乘，同底数幂相乘，单独字母连同指数照抄。",
          "单×多：用单项式乘多项式的每一项，再把积相加。",
          "多×多：用一个多项式的每一项去乘另一个多项式的每一项，再合并同类项。"
        ],
        "formula": [
          "(x＋p)(x＋q)＝x²＋(p＋q)x＋pq。"
        ],
        "pitfall": [
          "多项式相乘最易漏乘项或搞错负号；不含某次项 ⇒ 该次项合并后的系数等于 0。"
        ],
        "example": {
          "q": "计算 (x＋2)(x－5)。",
          "a": "x²＋(2－5)x＋2×(－5)＝x²－3x－10。"
        }
      },
      "qs": [
        {
          "lv": 1,
          "t": "c",
          "q": "计算 2x·(－3x²) 的结果是（ ）",
          "o": [
            "－6x²",
            "－6x³",
            "6x³",
            "－5x³"
          ],
          "a": "B",
          "e": "系数 2×(－3)＝－6，x·x²＝x³，得 －6x³。"
        },
        {
          "lv": 1,
          "t": "c",
          "q": "计算 2a(a－3) 的结果是（ ）",
          "o": [
            "2a²－3",
            "2a²－6a",
            "2a²＋6a",
            "a²－6a"
          ],
          "a": "B",
          "e": "分配律：2a·a－2a·3＝2a²－6a。坑点：漏乘 －3。"
        },
        {
          "lv": 1,
          "t": "c",
          "q": "计算 (x＋2)(x－5) 的结果是（ ）",
          "o": [
            "x²－3x－10",
            "x²＋3x－10",
            "x²－7x－10",
            "x²－3x＋10"
          ],
          "a": "A",
          "e": "x²＋(2－5)x－10＝x²－3x－10。"
        },
        {
          "lv": 2,
          "t": "b",
          "q": "若 (x＋3)(x＋m)＝x²＋nx－15，则 m＋n＝______。",
          "a": "-7 / －7",
          "e": "3m＝－15 得 m＝－5，n＝3＋m＝－2，m＋n＝－7。"
        },
        {
          "lv": 2,
          "t": "b",
          "q": "若 (x＋a)(x－2) 的展开式中不含 x 的一次项，则 a＝______。",
          "a": "2",
          "e": "一次项系数为 a－2＝0，解得 a＝2。"
        },
        {
          "lv": 2,
          "t": "c",
          "q": "计算 (2x－1)(x＋3) 的结果是（ ）",
          "o": [
            "2x²＋5x－3",
            "2x²－5x－3",
            "2x²＋7x－3",
            "2x²＋6x－3"
          ],
          "a": "A",
          "e": "2x²＋6x－x－3＝2x²＋5x－3。"
        },
        {
          "lv": 3,
