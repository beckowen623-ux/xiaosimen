{
  "chapter": "分式",
  "unit": "八上·分式",
  "points": [
    {
      "id": "p28",
      "name": "分式的概念与有意义/值为 0 的条件",
      "tag": "◆★",
      "kp": [
        "分式的概念"
      ],
      "card": {
        "concept": [
          "形如 A/B（A、B 是整式，且 B 中含有字母）的式子叫分式。",
          "分式 A/B 有意义 ⇔ 分母 B≠0；无意义 ⇔ 分母 B＝0。",
          "分式 A/B 的值为 0 ⇔ 分子 A＝0 且分母 B≠0。"
        ],
        "formula": [
          "π 是常数不是字母，所以 x/π 是整式不是分式！"
        ],
        "pitfall": [
          "求“分式值为 0”时，算出分子＝0 的解后，必须代入分母检验分母≠0，常考舍去增解！"
        ],
        "example": {
          "q": "当 x 为何值时，分式 (x²－4)/(x－2) 的值为 0？",
          "a": "分子 x²－4＝0 得 x＝±2；分母 x－2≠0 得 x≠2，所以 x＝－2。"
        }
      },
      "qs": [
        {
          "lv": 1,
          "t": "c",
          "q": "下列式子中，属于分式的是（ ）",
          "o": [
            "x/2",
            "x/π",
            "3/(x＋1)",
            "(a＋b)/3"
          ],
          "a": "C",
          "e": "分母中必须含有字母，π 是常数，只有 3/(x＋1) 分母含字母 x。"
        },
        {
          "lv": 1,
          "t": "c",
          "q": "要使分式 1/(x－3) 有意义，x 的取值范围是（ ）",
          "o": [
            "x≠3",
            "x＝3",
            "x＞3",
            "x≠0"
          ],
          "a": "A",
          "e": "分母 x－3≠0，即 x≠3。"
        },
        {
          "lv": 1,
          "t": "b",
          "q": "当 x＝______时，分式 (x－5)/(x＋2) 的值为 0。",
          "a": "5",
          "e": "分子 x－5＝0 得 x＝5，此时分母 5＋2＝7≠0。"
        },
        {
          "lv": 2,
          "t": "b",
          "q": "当 x＝______时，分式 (x²－4)/(x－2) 的值为 0。",
          "a": "-2 / －2",
          "e": "x²－4＝0 得 x＝±2，但 x＝2 时分母为 0 须舍去，故 x＝－2。坑点：写成 ±2。"
        },
        {
          "lv": 2,
          "t": "c",
          "q": "无论 x 取何实数，下列分式总有意义的是（ ）",
          "o": [
            "1/(x－1)",
            "1/x²",
            "1/(x²＋1)",
            "1/(x²－1)"
          ],
          "a": "C",
          "e": "x²≥0，所以 x²＋1≥1＞0 恒不为 0，总有意义。"
        },
        {
          "lv": 2,
          "t": "b",
          "q": "当 x＝______时，分式 (|x|－3)/(x＋3) 的值为 0。",
          "a": "3",
          "e": "|x|－3＝0 得 x＝±3，分母 x＋3≠0 得 x≠－3，故 x＝3。"
        },
        {
          "lv": 3,
          "t": "c",
          "q": "若分式 2/(x－1) 的值为整数，则整数 x 的值共有（ ）",
          "o": [
            "2 个",
            "3 个",
            "4 个",
            "无数个"
          ],
          "a": "C",
          "e": "x－1 为 2 的因数：±1、±2，对应 x＝2、0、3、－1，共 4 个。坑点：漏掉负因数。"
        },
        {
          "lv": 3,
          "t": "c",
          "q": "当 x＝2 时，分式 (x＋a)/(x－b) 无意义；当 x＝4 时，该分式值为 0，则 a＋b＝（ ）",
          "o": [
            "－2",
            "2",
            "－6",
            "6"
          ],
          "a": "A",
          "e": "x＝2 无意义得 2－b＝0 ⇒ b＝2；x＝4 值为 0 得 4＋a＝0 ⇒ a＝－4，a＋b＝－2。"
        }
      ]
    },
    {
      "id": "p29",
      "name": "分式的基本性质、约分与通分",
      "tag": "",
      "kp": [
        "分式的基本性质"
      ],
      "card": {
        "concept": [
          "分式的分子与分母同乘（或除以）同一个不等于 0 的整式，分式的值不变。",
          "约分：分子、分母先因式分解，再约去公因式，化为最简分式。",
          "通分：找各分母的最简公分母（系数最小公倍数×各因式最高次幂）。"
        ],
        "formula": [
          "符号法则：分子、分母、分式本身三个符号中，同时改变其中两个，分式的值不变。"
        ],
        "pitfall": [
          "分子分母中的 x、y 同时扩大 k 倍，要代入 kx、ky 检验分子分母扩大的倍数是否抵消！"
        ],
        "example": {
          "q": "把分式 x/(x＋y) 中的 x、y 都扩大 2 倍，分式的值怎么变？",
          "a": "2x/(2x＋2y)＝x/(x＋y)，分式的值不变。"
        }
      },
      "qs": [
        {
          "lv": 1,
          "t": "c",
          "q": "化简 (6a²b)/(9ab²) 的结果是（ ）",
          "o": [
            "2a/(3b)",
            "2b/(3a)",
            "2a/3",
            "3a/(2b)"
          ],
          "a": "A",
          "e": "分子分母同除以公因式 3ab，得 2a/(3b)。"
        },
        {
          "lv": 1,
          "t": "c",
          "q": "下列分式中，是最简分式的是（ ）",
          "o": [
            "(2x)/(4x²)",
            "(x²－1)/(x－1)",
            "(x＋1)/(x²＋1)",
            "(x－y)/(y－x)"
          ],
          "a": "C",
          "e": "(x＋1)/(x²＋1) 分子分母没有公因式，是最简分式。"
        },
        {
          "lv": 1,
          "t": "c",
          "q": "把分式 x/(x＋y) 中的 x 和 y 都扩大为原来的 2 倍，则分式的值（ ）",
          "o": [
            "扩大为原来的 2 倍",
            "缩小为原来的 1/2",
            "不变",
            "扩大为原来的 4 倍"
          ],
          "a": "C",
          "e": "(2x)/(2x＋2y)＝x/(x＋y)，值不变。"
        },
        {
          "lv": 2,
          "t": "c",
          "q": "把分式 (xy)/(x＋y) 中的 x 和 y 都扩大为原来的 3 倍，则分式的值（ ）",
          "o": [
            "不变",
            "扩大为原来的 3 倍",
            "扩大为原来的 9 倍",
            "缩小为原来的 1/3"
          ],
          "a": "B",
          "e": "(3x·3y)/(3x＋3y)＝9xy/[3(x＋y)]＝3·xy/(x＋y)，扩大为原来的 3 倍。"
        },
        {
          "lv": 2,
          "t": "c",
          "q": "约分 (x²－9)/(x²－6x＋9) 的结果是（ ）",
          "o": [
            "(x＋3)/(x－3)",
            "(x－3)/(x＋3)",
            "1",
            "(x＋3)/(x－6)"
          ],
          "a": "A",
          "e": "分子 (x＋3)(x－3)，分母 (x－3)²，约去 (x－3) 得 (x＋3)/(x－3)。"
        },
        {
          "lv": 2,
          "t": "c",
          "q": "分式 1/(2x²y) 与 1/(3xy³) 的最简公分母是（ ）",
          "o": [
            "6xy",
            "6x²y³",
            "6x³y⁴",
            "5x²y³"
          ],
          "a": "B",
          "e": "系数最小公倍数 6，x 最高次 2，y 最高次 3，即 6x²y³。"
        },
        {
          "lv": 3,
          "t": "c",
          "q": "下列变形正确的是（ ）",
          "o": [
            "(－a＋b)/c＝－(a＋b)/c",
            "(a＋1)/(b＋1)＝a/b",
            "(a－b)/(b－a)＝－1",
            "(a²－b²)/(a－b)＝a－b"
          ],
          "a": "C",
          "e": "a－b＝－(b－a)，商为 －1。坑点：第一项漏变 b 的符号。"
        },
        {
          "lv": 3,
          "t": "b",
          "q": "若 a/b＝2，则 (a＋b)/(a－b)＝______。",
          "a": "3",
          "e": "a＝2b，代入得 3b/b＝3。"
        }
      ]
    },
    {
      "id": "p30",
      "name": "分式的乘除与加减运算",
      "tag": "★",
      "kp": [],
      "card": {
        "concept": [
          "乘除：除以一个分式等于乘它的倒数；先因式分解再约分。",
          "加减：同分母分母不变分子相加减；异分母先通分再加减。"
        ],
        "formula": [
          "a/c ± b/c＝(a±b)/c；a/b ± c/d＝(ad±bc)/(bd)。"
        ],
        "pitfall": [
          "分式相减时，减数分子如果是多项式，必须加括号再去括号变号！",
          "运算结果一定要约分到最简分式或整式。"
        ],
        "example": {
          "q": "计算 x/(x－1)－1/(x－1)。",
          "a": "(x－1)/(x－1)＝1。"
        }
      },
      "qs": [
        {
          "lv": 1,
          "t": "c",
          "q": "计算 x/(x－1)－1/(x－1) 的结果是（ ）",
