    {
      "id": "p22",
      "name": "整体代入与配方法求最值",
      "tag": "★",
      "kp": [],
      "card": {
        "concept": [
          "降次整体代入：若已知 x²－3x＝1，不要硬解无理根，反复把 x² 替换成 3x＋1 降次！",
          "配方法求最值：把二次式配成 a(x－h)²＋k（或双变量配成 (x－a)²＋(y－b)²＋c），利用平方非负性秒求最值！"
        ],
        "formula": [
          "x²＋y²－2x＋4y＋8＝(x－1)²＋(y＋2)²＋3≥3（最小值为 3）。"
        ],
        "pitfall": [
          "配方提系数时注意符号：－2x²＋4x＋1＝－2(x－1)²＋3，常数项别算反！"
        ],
        "example": {
          "q": "已知 x²－3x－1＝0，求 x³－4x²＋2x＋5 的值。",
          "a": "x²＝3x＋1，x³－4x²＋2x＋5＝x(3x＋1)－4x²＋2x＋5＝－x²＋3x＋5＝－(x²－3x)＋5＝－1＋5＝4。",
          "img": "p22-complete.svg"
        }
      },
      "qs": [
        {
          "lv": 1,
          "t": "b",
          "q": "无论 x、y 取何实数，代数式 (x－2)²＋(y＋3)²＋5 的最小值是______。",
          "a": "5",
          "e": "两平方项均≥0，最小值为 5。"
        },
        {
          "lv": 1,
          "t": "b",
          "q": "已知 a²＋2a＝3，则 2a²＋4a－5＝______。",
          "a": "1",
          "e": "2(a²＋2a)－5＝6－5＝1。"
        },
        {
          "lv": 1,
          "t": "b",
          "q": "代数式 x²－6x＋13 的最小值是______。",
          "a": "4",
          "e": "(x－3)²＋4≥4，最小值为 4。"
        },
        {
          "lv": 2,
          "t": "b",
          "q": "代数式 x²＋y²－4x＋2y＋9 的最小值是______。",
          "a": "4",
          "e": "(x－2)²＋(y＋1)²＋4≥4，最小值为 4。"
        },
        {
          "lv": 2,
          "t": "b",
          "q": "已知 x²－3x－1＝0，则 x³－4x²＋2x＋5＝______。",
          "a": "4",
          "e": "x²＝3x＋1，原式＝x(3x＋1)－4x²＋2x＋5＝－(x²－3x)＋5＝－1＋5＝4。"
        },
        {
          "lv": 2,
          "t": "b",
          "q": "已知 x＋y＝6，则 xy 的最大值是______。",
          "a": "9",
          "e": "xy＝x(6－x)＝－(x－3)²＋9≤9，最大值为 9。"
        },
        {
          "lv": 3,
          "t": "b",
          "q": "已知实数 x 满足 x＋1/x＝3，则 x²＋1/x²＋2(x＋1/x)＝______。",
          "a": "13",
          "e": "x²＋1/x²＝9－2＝7，7＋2×3＝13。"
        },
        {
          "lv": 3,
          "t": "b",
          "q": "代数式 12/(x²－2x＋4) 的最大值是______。",
          "a": "4",
          "e": "分母＝(x－1)²＋3≥3，分母最小时分式最大：12÷3＝4。"
        }
      ]
