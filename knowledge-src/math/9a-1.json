      "card": {
        "concept": [
          "求根公式：当 Δ＝b²－4ac≥0 时，x＝(－b±√(b²－4ac))/(2a)。",
          "判别式 Δ＝b²－4ac 决定根的情况：Δ＞0 有两个不相等实根；Δ＝0 有两个相等实根；Δ＜0 无实数根。"
        ],
        "formula": [
          "方程有实数根 ⇔ Δ＝b²－4ac≥0。"
        ],
        "pitfall": [
          "算 Δ 前必须先化成一般形式 ax²＋bx＋c＝0，特别注意 c 的正负号！"
        ],
        "example": {
          "q": "判断方程 x²－3x＋4＝0 的根的情况。",
          "a": "Δ＝(－3)²－4×1×4＝9－16＝－7＜0，方程没有实数根。"
        }
      },
      "qs": [
